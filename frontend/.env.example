# Public backend origin without /api. Leave empty to use Vite's local /api proxy.
VITE_API_URL=http://localhost:8080
# Socket.IO server origin; normally the same as VITE_API_URL.
VITE_WS_URL=http://localhost:8080

# Razorpay publishable key (optional — omit to disable checkout until configured)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
