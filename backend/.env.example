# Server
NODE_ENV=development
PORT=8080

# Comma-free single origin for CORS + Socket.IO (Vite dev server)
FRONTEND_URL=http://localhost:3000

# MongoDB — use local MongoDB or your Atlas connection string
# Local: mongodb://127.0.0.1:27017/bidblaze
MONGODB_URI=mongodb://127.0.0.1:27017/bidblaze

# JWT — change this for any shared or production environment
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE=7d

# Razorpay (optional — payments routes work only when both are set)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional — image upload routes need these)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- AI Features ---
# Chatbot: set ONE of OpenAI or Gemini (or leave empty for rule-based demo mode)
# AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Recommendations: dummy | cosine (default)
# RECOMMENDATION_MODE=cosine

# Bid price prediction — Python ML microservice URL
# ML_SERVICE_URL=http://127.0.0.1:5000
